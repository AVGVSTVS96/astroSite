---
import MainLayout from '../layouts/MainLayout.astro';
import BlogTimeline from '@components/BlogTimeline.astro';
import Projects from '@components/Projects.astro';
import { Icon } from 'astro-icon/components';
---

<MainLayout
  title="Bassim Shahidy"
  description="Bassim Shahidy's personal website">
  <div class="w-full">
    {/* Hero */}
    <section class="border-b border-border">
      <div class="max-w-3xl mx-auto px-6 py-16 sm:py-20">
        <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight text-foreground">
          Bassim Shahidy
        </h1>
        <p class="mt-4 text-[15px] leading-relaxed text-muted-foreground max-w-lg">
          Founding engineer at{' '}
          <a href="https://github.com/assistant-ui/assistant-ui" class="link">assistant-ui</a>
          <span class="ml-1.5 inline-flex items-baseline">
            <span class="px-1.5 py-0.5 text-[10px] font-mono font-medium rounded bg-accent-500/10 text-accent-600 dark:text-accent-400">
              YC W25
            </span>
          </span>
        </p>
        <div class="mt-6 flex items-center gap-3">
          <a href="https://github.com/AVGVSTVS96" class="link-subtle" aria-label="GitHub">
            <Icon name="github" class="size-[18px]" />
          </a>
          <a href="https://linkedin.com/in/bassimshahidy" class="link-subtle" aria-label="LinkedIn">
            <Icon name="linkedin" class="size-[18px]" />
          </a>
        </div>
      </div>
    </section>

    {/* Content Grid */}
    <section class="border-b border-border">
      <div class="max-w-3xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2">
          {/* Posts */}
          <div class="px-6 py-10 md:border-r border-border">
            <div class="flex items-baseline justify-between mb-6">
              <span class="label">Writing</span>
              <a href="/blog" class="text-[11px] font-mono text-muted-foreground hover:text-foreground transition-colors duration-150">
                All posts →
              </a>
            </div>
            <BlogTimeline postCount={3} />
          </div>

          {/* Projects */}
          <div class="px-6 py-10 border-t md:border-t-0 border-border">
            <div class="mb-6">
              <span class="label">Projects</span>
            </div>
            <Projects />
          </div>
        </div>
      </div>
    </section>

    {/* About */}
    <section>
      <div class="max-w-3xl mx-auto px-6 py-10">
        <div class="grid grid-cols-1 sm:grid-cols-[100px_1fr] gap-6">
          <span class="label">About</span>
          <p class="text-[15px] leading-relaxed text-muted-foreground">
            Based in SF. Building{' '}
            <a href="https://github.com/AVGVSTVS96/react-shiki" class="link">react-shiki</a>
            {' '}and contributing to the AI chat ecosystem.
          </p>
        </div>
      </div>
    </section>
  </div>
</MainLayout>
