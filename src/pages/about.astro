---
import MainLayout from '@layouts/MainLayout.astro';
---

<MainLayout title="About" description="About Bassim Shahidy">
  <div class="w-full max-w-5xl mx-auto px-4 sm:px-6 py-16 sm:py-24">
    <header class="mb-16">
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight">About</h1>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16">
      <!-- Main content -->
      <section class="lg:col-span-8">
        <h2 class="text-xs font-mono uppercase tracking-wider text-muted-foreground mb-6">
          About Me
        </h2>
        <div class="space-y-4 text-muted-foreground leading-relaxed">
          <p>
            Based in SF, I'm a software engineer and open source developer
            obsessed with building tools that solve meaningful problems and push
            the craft forward. I live for writing code that feels beautiful —
            thoughtful interfaces, smart design, and tools that just work.
          </p>
          <p>
            I'm building{' '}
            <a href="https://github.com/AVGVSTVS96/react-shiki" class="text-foreground hover:text-accent-500 transition-colors">react-shiki</a>,
            a fast and flexible client-focused syntax highlighter for React. It
            provides a clean component API like{' '}
            <a href="https://github.com/react-syntax-highlighter/react-syntax-highlighter" class="text-foreground hover:text-accent-500 transition-colors">react-syntax-highlighter</a>,
            alongside a more flexible React hook, bringing the modern, powerful{' '}
            <a href="https://github.com/shikijs/shiki" class="text-foreground hover:text-accent-500 transition-colors">Shiki</a>{' '}
            syntax highlighter to React in an elegant and intuitive package.
          </p>
          <p>
            I'm also a Founding Engineer at{' '}
            <a href="https://github.com/assistant-ui/assistant-ui" class="text-foreground hover:text-accent-500 transition-colors">assistant-ui</a>,
            where we're raising the bar for developer experience (DX) and
            accessibility in AI chat. It's a powerful SDK paired with a
            shadcn-style UI library, giving you everything you need to spin up
            an advanced, type-safe chat app with best-in-class design,
            accessibility, and performance.
          </p>
        </div>
      </section>

      <!-- Sidebar -->
      <aside class="lg:col-span-4 lg:border-l border-border lg:pl-8">
        <h2 class="text-xs font-mono uppercase tracking-wider text-muted-foreground mb-6">
          This Site
        </h2>
        <p class="text-sm text-muted-foreground leading-relaxed">
          Built with Astro, Tailwind CSS, and React. A portfolio and sandbox
          for trying new ideas and features.
        </p>

        <div class="mt-8 pt-8 border-t border-border">
          <h2 class="text-xs font-mono uppercase tracking-wider text-muted-foreground mb-4">
            Stack
          </h2>
          <ul class="space-y-2 text-sm text-muted-foreground font-mono">
            <li>Astro</li>
            <li>React</li>
            <li>Tailwind CSS</li>
            <li>TypeScript</li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</MainLayout>
