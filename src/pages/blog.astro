---
import BaseLayout from '@layouts/BaseLayout.astro';
import BlogTimeline from '@components/BlogTimeline.astro';
---

<BaseLayout title="Blog" description="Blog posts by Bassim Shahidy">
  <div class="w-full">
    <section class="border-b border-border">
      <div class="max-w-3xl mx-auto px-6 py-16 sm:py-20">
        <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight text-foreground">
          Blog
        </h1>
        <p class="mt-4 text-[15px] text-muted-foreground">
          Writing about software, web development, and building things.
        </p>
      </div>
    </section>

    <section>
      <div class="max-w-3xl mx-auto px-6 py-10">
        <div class="mb-6">
          <span class="label">All Posts</span>
        </div>
        <BlogTimeline lineClamp="line-clamp-3" />
      </div>
    </section>
  </div>
</BaseLayout>
