---
import BaseLayout from '@layouts/BaseLayout.astro';
import BlogTimeline from '@components/BlogTimeline.astro';
---

<BaseLayout title="Blog" description="Blog posts by Bassim Shahidy">
  {/* Hero */}
  <div class="w-full border-b border-border">
    <div class="p-8 lg:p-12 min-h-[30vh] flex flex-col justify-end">
      <h1 class="text-4xl lg:text-5xl font-semibold tracking-tight">Blog</h1>
      <p class="mt-4 text-[15px] text-muted-foreground max-w-md">
        Writing about software, web development, and building things.
      </p>
    </div>
  </div>

  {/* Posts */}
  <div class="w-full">
    <div class="p-8 lg:p-12">
      <div class="mb-8">
        <span class="label">All Posts</span>
      </div>
      <div class="max-w-2xl">
        <BlogTimeline lineClamp="line-clamp-3" />
      </div>
    </div>
  </div>
</BaseLayout>
