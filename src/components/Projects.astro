---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import { getPackageVersions } from '@/lib/utils/getNpmVersion';

const projects = await getCollection('projects');
const versions = await getPackageVersions(projects);
---

<ul class="space-y-5">
  {
    projects.map((project) => (
      <li class="group">
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0 flex-1">
            <div class="flex items-center gap-2">
              <a
                href={project.data.url}
                class="text-[15px] font-medium text-foreground group-hover:text-accent-500 transition-colors duration-150 truncate">
                {project.data.title}
              </a>
              {project.data.package && (
                <a
                  href={`https://www.npmjs.com/package/${project.data.title}`}
                  class="shrink-0">
                  <span class="text-[10px] font-mono text-muted-foreground hover:text-foreground transition-colors duration-150">
                    {versions.get(project.id)}
                  </span>
                </a>
              )}
            </div>
            <p class="mt-1 text-[13px] leading-relaxed text-muted-foreground line-clamp-2">
              {project.data.description}
            </p>
          </div>
          <a
            aria-label={`View ${project.data.title} on GitHub`}
            class="shrink-0 text-muted-foreground hover:text-foreground transition-colors duration-150"
            href={project.data.url}>
            <Icon name="github" class="size-4" />
          </a>
        </div>
      </li>
    ))
  }
</ul>
