---
import { Button } from '@components/ui/button';
import { ModeToggle } from '@components/ModeToggle';
import { SideMenu } from '@components/SideMenu';
import { CommandMenu } from '@components/CommandMenu';
import { mainLinks } from './navLinks';
import Logo from './Logo.astro';
import { AccentColorSelector } from './AccentColorSelector';
import { ProjectsDropdown } from './ProjectsDropdown';
import { sortedBlogPosts } from '@/lib/utils/getSortedPosts';
import { isActiveLink } from '@/lib/utils';
---

<header class="sticky top-0 z-50 w-full border-b border-border bg-background/80 backdrop-blur-sm">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between">
    <div class="flex items-center gap-8">
      <Logo />
      <nav class="hidden sm:flex items-center gap-1">
        {
          mainLinks.map((link, index) => {
            const currentPath = new URL(Astro.request.url).pathname;
            const isActive = isActiveLink(currentPath, link.href);

            return (
              <a
                href={link.href}
                class:list={[
                  'px-3 py-1.5 text-sm transition-colors rounded-md',
                  isActive
                    ? 'text-foreground'
                    : 'text-muted-foreground hover:text-foreground',
                ]}>
                {link.name}
              </a>
            );
          })
        }
        <ProjectsDropdown client:load />
      </nav>
    </div>
    <div class="flex items-center gap-1">
      <CommandMenu client:load sortedPosts={sortedBlogPosts} />
      <AccentColorSelector client:load />
      <SideMenu client:load sortedPosts={sortedBlogPosts} />
      <ModeToggle client:load />
    </div>
  </div>
</header>
