---
import { formatDate } from '@/lib/utils';
import { sortedBlogPosts } from '@/lib/utils/getSortedPosts';

const latestPosts = Astro.props.postCount
  ? sortedBlogPosts.slice(0, Astro.props.postCount)
  : sortedBlogPosts;

interface Props {
  postCount?: number;
  lineClamp?: string;
}

const { lineClamp = 'line-clamp-2' } = Astro.props;
---

<ul class="space-y-5">
  {
    latestPosts.map((post) => (
      <li>
        <a href={`/posts/${post.slug}`} class="group block">
          <div class="flex items-baseline justify-between gap-4">
            <h3 class="text-[15px] font-medium text-foreground group-hover:text-accent-500 transition-colors duration-150 truncate">
              {post.data.title}
            </h3>
            <time class="shrink-0 text-[11px] font-mono text-muted-foreground tabular-nums">
              {formatDate(post.data.pubDate)}
            </time>
          </div>
          <p class:list={['mt-1 text-[13px] leading-relaxed text-muted-foreground', lineClamp]}>
            {post.data.description}
          </p>
        </a>
      </li>
    ))
  }
</ul>
