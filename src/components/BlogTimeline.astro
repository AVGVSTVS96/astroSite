---
import { formatDate } from '@/lib/utils';
import { sortedBlogPosts } from '@/lib/utils/getSortedPosts';

const latestPosts = Astro.props.postCount
  ? sortedBlogPosts.slice(0, Astro.props.postCount)
  : sortedBlogPosts;

interface Props {
  postCount?: number;
  lineClamp?: string;
  split?: boolean;
}

const { lineClamp, split = false } = Astro.props;
---

<div class="space-y-4">
  {
    latestPosts.map((post) => (
      <article class="group">
        <a href={`/posts/${post.slug}`} class="block">
          <div class="flex items-baseline justify-between gap-4 mb-1">
            <h3 class="font-medium text-foreground group-hover:text-accent-500 transition-colors">
              {post.data.title}
            </h3>
            <time class="shrink-0 text-xs font-mono text-muted-foreground tabular-nums">
              {formatDate(post.data.pubDate)}
            </time>
          </div>
          <p class:list={['text-sm text-muted-foreground', lineClamp]}>
            {post.data.description}
          </p>
        </a>
        <div class="mt-4 border-b border-border/50 group-last:border-0" />
      </article>
    ))
  }
</div>
